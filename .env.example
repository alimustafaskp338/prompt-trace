# ==============================================================================
# PROMPTTRACE - ENVIRONMENT VARIABLES FOR VERCEL & PRODUCTION DEPLOYMENT
# ==============================================================================
# Instructions for Vercel:
# 1. In your Vercel Project Dashboard, navigate to: Settings > Environment Variables
# 2. Add each variable below with your production values.
# 3. For client-side variables (prefixed with VITE_), they will be baked into the
#    frontend during 'vite build' on Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & HOSTING CONFIGURATION
# ------------------------------------------------------------------------------
# NODE_ENV: Set to 'production' on Vercel
NODE_ENV="production"

# APP_URL: The canonical URL where your Vercel project is hosted
# Example: https://prompttrace.vercel.app or https://your-custom-domain.com
APP_URL="https://prompttrace.vercel.app"

# VITE_APP_URL: Client-side copy of the public application URL
VITE_APP_URL="https://prompttrace.vercel.app"

# PORT: Optional for local development (Vercel assigns port automatically)
PORT="3000"

# ------------------------------------------------------------------------------
# 2. JAZZCASH & MANUAL PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# JAZZCASH_NUMBER: Phone number where users send direct JazzCash payments
JAZZCASH_NUMBER="+923105905246"

# VITE_JAZZCASH_NUMBER: Publicly visible JazzCash payment number shown in UI
VITE_JAZZCASH_NUMBER="+923105905246"

# VITE_JAZZCASH_ACCOUNT_TITLE: Account holder title displayed to users during checkout
VITE_JAZZCASH_ACCOUNT_TITLE="Ali Mustafa (PromptTrace Official)"

# ------------------------------------------------------------------------------
# 3. ADMIN PANEL & SECURITY CREDENTIALS
# ------------------------------------------------------------------------------
# ADMIN_EMAIL: Email of the master administrator (Ali Mustafa)
ADMIN_EMAIL="alimustafaskp338@gmail.com"

# VITE_ADMIN_EMAIL: Public admin contact email
VITE_ADMIN_EMAIL="alimustafaskp338@gmail.com"

# ADMIN_SECRET_KEY: Secret key used to sign and authenticate admin access tokens
ADMIN_SECRET_KEY="pt_sec_replace_with_secure_64_character_random_hex_string"

# E2EE_PEPPER_SECRET: High-entropy secret pepper for End-to-End Encryption key derivation
E2EE_PEPPER_SECRET="pt_e2ee_pepper_replace_with_random_high_entropy_secret_key"

# ------------------------------------------------------------------------------
# 4. AI & SDK CREDENTIALS
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key (required if AI reasoning or transcription is enabled)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# PROMPTTRACE_API_KEY: Master client SDK key for live data passport ingestion
PROMPTTRACE_API_KEY="pt_live_9f8302ba1c4d92"
